IMAGE_TAG=local
IMAGE_NAME=random-image-api
APP_PORT=10086
APP_HOST=0.0.0.0
APP_BIND_PORT=10086
DATA_DIR=./data
IMAGES_DIR=./data/images
DATABASE_PATH=./data/database/images.db
LOG_DIR=./data/logs
LOG_LEVEL=INFO
ADMIN_TOKEN=
FALLBACK_ENABLED=true
SQUARE_POLICY=both
SCAN_ON_STARTUP=true
SCAN_INTERVAL_SECONDS=300
MAX_PICK_RETRIES=8
TRUSTED_PROXY_HEADERS=true

# Storage: local (default, no WebDAV requests) or hybrid
STORAGE_MODE=local
HYBRID_REMOTE_PROBABILITY=0.9

# WebDAV is required only when STORAGE_MODE=hybrid.
# Credentials must stay in .env and must never be committed.
WEBDAV_BASE_URL=
WEBDAV_DESKTOP_ROOT=/desktop/
WEBDAV_MOBILE_ROOT=/mobile/
WEBDAV_ALLOWED_HOSTS=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_TIMEOUT_SECONDS=10
WEBDAV_SYNC_INTERVAL_SECONDS=300
WEBDAV_MAX_XML_BYTES=2097152
WEBDAV_MAX_OBJECTS=10000
WEBDAV_MAX_DOWNLOAD_BYTES=26214400

# Compose overrides CACHE_DIR to /app/data/cache/webdav.
CACHE_DIR=./data/cache/webdav
CACHE_MAX_BYTES=1073741824
CACHE_MAX_FILES=2000
CACHE_REFRESH_AFTER_SECONDS=3600
CACHE_ROTATE_PERCENT=10

# V2 管理网页：ADMIN_TOKEN 与独立 ADMIN_SESSION_SECRET 必须同时设置才启用。
# 建议分别执行两次：openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_PATH=/manage-images
ADMIN_COOKIE_NAME=ria_admin_session
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_PREVIEW_TTL_SECONDS=600
ADMIN_LOGIN_WINDOW_SECONDS=60
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_MAX_UPLOAD_BYTES=26214400
ADMIN_PAGE_SIZE=20
ADMIN_MAX_ARCHIVE_BYTES=536870912
ADMIN_MAX_ARCHIVE_MEMBERS=10000
ADMIN_MAX_ARCHIVE_MEMBER_BYTES=104857600
ADMIN_MAX_ARCHIVE_TOTAL_BYTES=1073741824
ADMIN_MAX_ARCHIVE_COMPRESSION_RATIO=200
ADMIN_MAX_IMAGE_PIXELS=100000000
# Compose 覆盖为容器内临时目录；Backup 不包含该目录。
UPLOAD_TMP_DIR=./data/tmp/admin
